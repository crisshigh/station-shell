<Window x:Class="StationShell.Desktop.Views.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion Station Shell — Admin"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0F1923">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <StackPanel Grid.Column="0" Background="#0A1628">
            <Border Background="#0F3460" Padding="20,25">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="36" Height="36" Fill="#DD1F26"/>
                        <TextBlock Text="SHELL" FontSize="20" FontWeight="Black"
                                   Foreground="#FFC200" Margin="-28,6,0,0"/>
                    </StackPanel>
                    <TextBlock Text="ADMINISTRATION" FontSize="10" FontWeight="Bold"
                               Foreground="#888888" HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Infos utilisateur -->
            <Border Padding="15,12" Background="#0D1F3C">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="36" Height="36" Fill="#DD1F26"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Administrateur" FontSize="12"
                                   FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="admin@shell.com" FontSize="10"
                                   Foreground="#666688"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Navigation -->
            <StackPanel Margin="0,15,0,0">
                <Border Background="#DD1F26" Margin="10,2" Padding="15,12" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⊞" FontSize="16" Foreground="White"/>
                        <TextBlock Text="Tableau de bord" FontSize="13"
                                   FontWeight="Bold" Foreground="White" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="PISTE" FontSize="10" Foreground="#FFC200"
                           FontWeight="Bold" Margin="15,15,0,5"/>
                <TextBlock Text="⛽  Indexes Pompes" FontSize="13" Foreground="#AAAAAA"
                            Padding="15,12" Margin="10,2" Cursor="Hand"
                             MouseLeftButtonDown="MenuPiste_Click"/>
                <TextBlock Text="🛢  Cuves" FontSize="13" Foreground="#AAAAAA"
                           Padding="15,12" Margin="10,2" Cursor="Hand"/>
                <TextBlock Text="🔧  Ventes Piste" FontSize="13" Foreground="#AAAAAA"
                           Padding="15,12" Margin="10,2" Cursor="Hand"/>

                <TextBlock Text="BOUTIQUE" FontSize="10" Foreground="#FFC200"
                           FontWeight="Bold" Margin="15,15,0,5"/>
                <TextBlock Text="📦  Stock" FontSize="13" Foreground="#AAAAAA"
                           Padding="15,12" Margin="10,2" Cursor="Hand"/>
                <TextBlock Text="🧾  Ventes Boutique" FontSize="13" Foreground="#AAAAAA"
                           Padding="15,12" Margin="10,2" Cursor="Hand"/>

                <TextBlock Text="GESTION" FontSize="10" Foreground="#FFC200"
                           FontWeight="Bold" Margin="15,15,0,5"/>
                <TextBlock Text="👥  Personnel" FontSize="13" Foreground="#AAAAAA"
                           Padding="15,12" Margin="10,2" Cursor="Hand"/>
                <TextBlock Text="👤  Utilisateurs" FontSize="13" Foreground="#AAAAAA"
                           Padding="15,12" Margin="10,2" Cursor="Hand"/>
            </StackPanel>

            <!-- Déconnexion -->
            <TextBlock Text="⏻  Déconnexion" FontSize="13" Foreground="#DD1F26"
                       FontWeight="Bold" Padding="15,12" Margin="10,20,10,10"
                       Background="#1A0A0A" Cursor="Hand"/>
        </StackPanel>

        <!-- CONTENU PRINCIPAL -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0A1628" Padding="25,0">
                <DockPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tableau de bord" FontSize="20"
                                   FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Lundi 09 Mars 2026" FontSize="11"
                                   Foreground="#555577"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="🔔" FontSize="20"
                               Foreground="#FFC200" VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- Contenu -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="25">
                    <TextBlock Text="Vue d'ensemble" FontSize="15" FontWeight="Bold"
                               Foreground="#888888" Margin="0,0,0,15"/>

                    <!-- 4 cartes stats -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,10,0" Background="#0A1628" Padding="20">
                            <StackPanel>
                                <TextBlock Text="💰" FontSize="24"/>
                                <TextBlock Text="Ventes du jour" FontSize="11"
                                           Foreground="#666688" Margin="0,8,0,4"/>
                                <TextBlock Text="0 FCFA" FontSize="20"
                                           FontWeight="Bold" Foreground="White"/>
                                <Rectangle Height="2" Fill="#DD1F26" Width="40"
                                           HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="0,0,10,0" Background="#0A1628" Padding="20">
                            <StackPanel>
                                <TextBlock Text="⛽" FontSize="24"/>
                                <TextBlock Text="Carburant vendu" FontSize="11"
                                           Foreground="#666688" Margin="0,8,0,4"/>
                                <TextBlock Text="0 L" FontSize="20"
                                           FontWeight="Bold" Foreground="White"/>
                                <Rectangle Height="2" Fill="#FFC200" Width="40"
                                           HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Margin="0,0,10,0" Background="#0A1628" Padding="20">
                            <StackPanel>
                                <TextBlock Text="📦" FontSize="24"/>
                                <TextBlock Text="Articles en stock" FontSize="11"
                                           Foreground="#666688" Margin="0,8,0,4"/>
                                <TextBlock Text="0" FontSize="20"
                                           FontWeight="Bold" Foreground="White"/>
                                <Rectangle Height="2" Fill="#00C896" Width="40"
                                           HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#0A1628" Padding="20">
                            <StackPanel>
                                <TextBlock Text="👥" FontSize="24"/>
                                <TextBlock Text="Personnel actif" FontSize="11"
                                           Foreground="#666688" Margin="0,8,0,4"/>
                                <TextBlock Text="0" FontSize="20"
                                           FontWeight="Bold" Foreground="White"/>
                                <Rectangle Height="2" Fill="#0F3460" Width="40"
                                           HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Ligne 2 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- Activité récente -->
                        <Border Grid.Column="0" Margin="0,0,15,0" Background="#0A1628" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Activité récente" FontSize="14"
                                           FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                                <TextBlock Text="Aucune activité enregistrée pour le moment."
                                           Foreground="#444466" FontSize="12"
                                           HorizontalAlignment="Center" Margin="0,30,0,30"/>
                            </StackPanel>
                        </Border>

                        <!-- Accès rapides -->
                        <Border Grid.Column="1" Background="#0A1628" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Accès rapides" FontSize="14"
                                           FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                                <Border Background="#0F3460" Padding="15,12" Margin="0,0,0,8" Cursor="Hand">
                                    <TextBlock Text="⛽  Saisir indexes" FontSize="12" Foreground="White"/>
                                </Border>
                                <Border Background="#0F3460" Padding="15,12" Margin="0,0,0,8" Cursor="Hand">
                                    <TextBlock Text="🧾  Nouvelle vente" FontSize="12" Foreground="White"/>
                                </Border>
                                <Border Background="#0F3460" Padding="15,12" Margin="0,0,0,8" Cursor="Hand">
                                    <TextBlock Text="📦  Gérer le stock" FontSize="12" Foreground="White"/>
                                </Border>
                                <Border Background="#0F3460" Padding="15,12" Cursor="Hand">
                                    <TextBlock Text="👥  Pointage personnel" FontSize="12" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>