                                <Border Background="#0D1F3C" Padding="15">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="TxtAvancePersonnel" Background="#0F3460" Foreground="White" BorderBrush="#FFC200" BorderThickness="0,0,0,1" Height="32" Padding="8,4" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1" x:Name="TxtAvanceMontant" Background="#0F3460" Foreground="White" BorderBrush="#FFC200" BorderThickness="0,0,0,1" Height="32" Padding="8,4" Margin="0,0,8,0"/>
                                            <Border Grid.Column="2" Background="#DD1F26" Padding="8,6" Cursor="Hand" MouseLeftButtonDown="BtnAjouterAvance_Click">
                                                <TextBlock Text="+ Ajouter" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Rectangle Height="1" Fill="#1A2D50" Margin="0,5,0,8"/>
                                        <StackPanel x:Name="ListeAvances"/>
                                        <Rectangle Height="1" Fill="#1A2D50" Margin="0,8,0,5"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="TOTAL AVANCES : " FontSize="11" FontWeight="Bold" Foreground="#888888"/>
                                            <TextBlock x:Name="TxtTotalAvances" Text="0 FCFA" FontSize="11" FontWeight="Bold" Foreground="#DD1F26"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="RÉCAPITULATIF GLOBAL DU JOUR" FontSize="11" FontWeight="Bold"
                            Foreground="#FFC200" Margin="0,25,0,10"/>
                    <Border Background="#0D1F3C" Padding="25">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Total Super vendu : " FontSize="12" Foreground="#888888" Width="200"/>
                                    <TextBlock x:Name="TxtRecapSuper" Text="0.00 L" FontSize="12" Foreground="#00C896" Width="100"/>
                                    <TextBlock x:Name="TxtRecapSuperMontant" Text="0 FCFA" FontSize="12" Foreground="White"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Total Gasoil vendu : " FontSize="12" Foreground="#888888" Width="200"/>
                                    <TextBlock x:Name="TxtRecapGasoil" Text="0.00 L" FontSize="12" Foreground="#00C896" Width="100"/>
                                    <TextBlock x:Name="TxtRecapGasoilMontant" Text="0 FCFA" FontSize="12" Foreground="White"/>
                                </StackPanel>
                                <Rectangle Height="1" Fill="#1A2D50" Margin="0,8,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Total ventes brutes : " FontSize="12" Foreground="#888888" Width="200"/>
                                    <TextBlock x:Name="TxtRecapBrut" Text="0 FCFA" FontSize="12" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="+ Décharges collectées : " FontSize="12" Foreground="#888888" Width="200"/>
                                    <TextBlock x:Name="TxtRecapDecharges" Text="0 FCFA" FontSize="12" Foreground="#00C896"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="- Charges station : " FontSize="12" Foreground="#888888" Width="200"/>
                                    <TextBlock x:Name="TxtRecapCharges" Text="0 FCFA" FontSize="12" Foreground="#DD1F26"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="- Avances sur salaire : " FontSize="12" Foreground="#888888" Width="200"/>
                                    <TextBlock x:Name="TxtRecapAvances" Text="0 FCFA" FontSize="12" Foreground="#DD1F26"/>
                                </StackPanel>
                                <Rectangle Height="2" Fill="#FFC200" Margin="0,10,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CAISSE NETTE TOTALE : " FontSize="14" FontWeight="Bold" Foreground="White" Width="200"/>
                                    <TextBlock x:Name="TxtCaisseNette" Text="0 FCFA" FontSize="14" FontWeight="Bold" Foreground="#FFC200"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Background="#DD1F26" Padding="20,15" Cursor="Hand"
                                        MouseLeftButtonDown="BtnCloturerCaisse_Click">
                                    <StackPanel>
                                        <TextBlock Text="🔒" FontSize="24" HorizontalAlignment="Center"/>
                                        <TextBlock Text="CLÔTURER LA CAISSE" FontSize="12"
                                                FontWeight="Bold" Foreground="White"
                                                HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- PANEL CUVES -->
            <ScrollViewer x:Name="PanelCuves" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="25">
                    <TextBlock Text="État des cuves" FontSize="15" FontWeight="Bold"
                               Foreground="#888888" Margin="0,0,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="0,0,12,0" Background="#0A1628" Padding="25">
                            <StackPanel>
                                <TextBlock Text="🛢" FontSize="30" HorizontalAlignment="Center"/>
                                <TextBlock Text="SUPER" FontSize="14" FontWeight="Bold"
                                           Foreground="#FFC200" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                <TextBlock Text="QUANTITÉ ACTUELLE (L)" FontSize="10"
                                           FontWeight="Bold" Foreground="#FFC200" Margin="0,15,0,6"/>
                                <TextBox Background="#0F3460" Foreground="White"
                                         BorderBrush="#FFC200" BorderThickness="0,0,0,2"
                                         Height="40" Padding="10,5" FontSize="16"/>
                                <Border Background="#DD1F26" Padding="12,10" Margin="0,15,0,0" Cursor="Hand">
                                    <TextBlock Text="METTRE À JOUR" FontSize="11"
                                               FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#0A1628" Padding="25">
                            <StackPanel>
                                <TextBlock Text="🛢" FontSize="30" HorizontalAlignment="Center"/>
                                <TextBlock Text="GASOIL" FontSize="14" FontWeight="Bold"
                                           Foreground="#FFC200" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                <TextBlock Text="QUANTITÉ ACTUELLE (L)" FontSize="10"
                                           FontWeight="Bold" Foreground="#FFC200" Margin="0,15,0,6"/>
                                <TextBox Background="#0F3460" Foreground="White"
                                         BorderBrush="#FFC200" BorderThickness="0,0,0,2"
                                         Height="40" Padding="10,5" FontSize="16"/>
                                <Border Background="#DD1F26" Padding="12,10" Margin="0,15,0,0" Cursor="Hand">
                                    <TextBlock Text="METTRE À JOUR" FontSize="11"
                                               FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- PANEL VENTES -->
            <ScrollViewer x:Name="PanelVentes" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="25">
                    <TextBlock Text="Ventes Piste" FontSize="15" FontWeight="Bold"
                               Foreground="#888888" Margin="0,0,0,20"/>
                    <Border Background="#0A1628" Padding="20">
                        <TextBlock Text="Aucune vente enregistrée."
                                   Foreground="#444466" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,20"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
