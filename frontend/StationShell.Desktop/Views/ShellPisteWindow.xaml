<Window x:Class="StationShell.Desktop.Views.ShellPisteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shell Piste — Gestion de la Piste"
        Height="800" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#0F1923">

    <Window.Resources>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#0F3460"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1A4A80"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"/>
                                    <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                                  Focusable="False"
                                                  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Path Grid.Column="1"
                                          Fill="#FFC200"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#0F3460"
                                        BorderBrush="#1A4A80"
                                        BorderThickness="1"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FFC200"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd" Background="#0F3460" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A4A80"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DD1F26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#0F3460"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFC200"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <StackPanel Grid.Column="0" Background="#0A1628">
            <Border Background="#0F3460" Padding="20,25">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="36" Height="36" Fill="#DD1F26"/>
                        <TextBlock Text="SHELL" FontSize="20" FontWeight="Black"
                                   Foreground="#FFC200" Margin="-28,6,0,0"/>
                    </StackPanel>
                    <TextBlock Text="SHELL PISTE" FontSize="10" FontWeight="Bold"
                               Foreground="#FFC200" HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Padding="15,12" Background="#0D1F3C">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="36" Height="36" Fill="#DD1F26"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Chef de Piste" FontSize="12"
                                   FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="piste@shell.com" FontSize="10"
                                   Foreground="#666688"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,15,0,0">
                <Border x:Name="MenuIndexesBorder" Background="#DD1F26"
                        Margin="10,2" Padding="15,12" Cursor="Hand"
                        MouseLeftButtonDown="MenuIndexes_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⛽" FontSize="16" Foreground="White"/>
                        <TextBlock Text="Indexes Pompes" FontSize="13"
                                   FontWeight="Bold" Foreground="White" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="MenuCaissesBorder" Background="#0A1628"
                        Margin="10,2" Padding="15,12" Cursor="Hand"
                        MouseLeftButtonDown="MenuCaisses_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💰" FontSize="16" Foreground="#AAAAAA"/>
                        <TextBlock Text="Caisse du jour" FontSize="13"
                                   Foreground="#AAAAAA" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="MenuCuvesBorder" Background="#0A1628"
                        Margin="10,2" Padding="15,12" Cursor="Hand"
                        MouseLeftButtonDown="MenuCuves_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛢" FontSize="16" Foreground="#AAAAAA"/>
                        <TextBlock Text="Cuves" FontSize="13"
                                   Foreground="#AAAAAA" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="MenuVentesBorder" Background="#0A1628"
                        Margin="10,2" Padding="15,12" Cursor="Hand"
                        MouseLeftButtonDown="MenuVentes_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔧" FontSize="16" Foreground="#AAAAAA"/>
                        <TextBlock Text="Ventes Piste" FontSize="13"
                                   Foreground="#AAAAAA" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="PERSONNEL" FontSize="10" Foreground="#FFC200"
                           FontWeight="Bold" Margin="15,15,0,5"/>
                <Border Background="#0A1628" Margin="10,2" Padding="15,12" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👥" FontSize="16" Foreground="#AAAAAA"/>
                        <TextBlock Text="Pointage" FontSize="13"
                                   Foreground="#AAAAAA" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="⏻  Retour" FontSize="13" Foreground="#DD1F26"
                       FontWeight="Bold" Padding="15,12" Margin="10,20,10,10"
                       Background="#1A0A0A" Cursor="Hand"
                       MouseLeftButtonDown="BtnRetour_Click"/>
        </StackPanel>

        <!-- CONTENU PRINCIPAL -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0A1628" Padding="25,0">
                <DockPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPageTitre" Text="Indexes Pompes"
                                   FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="TxtDateJour" FontSize="11" Foreground="#7898B0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== PANEL INDEXES ===== -->
            <ScrollViewer x:Name="PanelIndexes" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel Margin="20">

                    <!-- ══════════════════════════════════════════════ -->
                    <!-- SECTION 1 — AGENT & PLAGE HORAIRE             -->
                    <!-- ══════════════════════════════════════════════ -->
                    <Border Background="#0A1628" Margin="0,0,0,12">
                        <StackPanel>
                            <Border Background="#0D1F3C" Padding="12,9">
                                <TextBlock Text="1.  AGENT &amp; PLAGE HORAIRE"
                                           FontSize="11" FontWeight="Bold" Foreground="#FFC200"/>
                            </Border>
                            <Border Padding="15,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Agent -->
                                    <StackPanel Grid.Column="0" Margin="0,0,25,0">
                                        <TextBlock Text="AGENT RESPONSABLE" FontSize="10"
                                                   FontWeight="Bold" Foreground="#FFC200" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CbAgent" Height="34">
                                            <ComboBoxItem Content="-- Choisir un agent --" IsSelected="True"/>
                                            <ComboBoxItem Content="Pompiste 1"/>
                                            <ComboBoxItem Content="Pompiste 2"/>
                                            <ComboBoxItem Content="Pompiste 3"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Plage horaire -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="PLAGE HORAIRE" FontSize="10"
                                                   FontWeight="Bold" Foreground="#FFC200" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Date début" FontSize="10"
                                                           Foreground="#7898B0" Margin="0,0,0,3"/>
                                                <DatePicker x:Name="DpDebut" Width="148" Height="34"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,20,0">
                                                <TextBlock Text="Heure" FontSize="10"
                                                           Foreground="#7898B0" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TxtHeureDebut" Width="68" Height="34"
                                                         Background="#0F3460" Foreground="White"
                                                         BorderBrush="#FFC200" BorderThickness="0,0,0,1"
                                                         Padding="6,4" TextAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="→" FontSize="18" Foreground="#7898B0"
                                                       VerticalAlignment="Bottom" Margin="0,0,20,4"/>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Date fin" FontSize="10"
                                                           Foreground="#7898B0" Margin="0,0,0,3"/>
                                                <DatePicker x:Name="DpFin" Width="148" Height="34"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Heure" FontSize="10"
                                                           Foreground="#7898B0" Margin="0,0,0,3"/>
                                                <TextBox x:Name="TxtHeureFin" Width="68" Height="34"
                                                         Background="#0F3460" Foreground="White"
                                                         BorderBrush="#FFC200" BorderThickness="0,0,0,1"
                                                         Padding="6,4" TextAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════ -->
                    <!-- SECTION 2 — INDEXES POMPES                    -->
                    <!-- ══════════════════════════════════════════════ -->
                    <Border Background="#0A1628" Margin="0,0,0,12">
                        <StackPanel>
                            <Border Background="#0D1F3C" Padding="12,9">
                                <TextBlock Text="2.  INDEXES POMPES"
                                           FontSize="11" FontWeight="Bold" Foreground="#FFC200"/>
                            </Border>
                            <StackPanel Margin="10,8,10,10">

                                <!-- En-tête colonnes (8 col, sans POMPISTE) -->
                                <Border Background="#0D1F3C" Padding="10,8" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ÎLOT" FontSize="10" FontWeight="Bold" Foreground="#FFC200"/>
                                        <TextBlock Grid.Column="1" Text="POMPE" FontSize="10" FontWeight="Bold" Foreground="#FFC200"/>
                                        <TextBlock Grid.Column="2" Text="CARBURANT" FontSize="10" FontWeight="Bold" Foreground="#FFC200"/>
                                        <TextBlock Grid.Column="3" Text="IDX DÉPART" FontSize="10" FontWeight="Bold" Foreground="#FFC200"/>
                                        <TextBlock Grid.Column="4" Text="IDX ARRIVÉE" FontSize="10" FontWeight="Bold" Foreground="#FFC200"/>
                                        <TextBlock Grid.Column="5" Text="QTÉ (L)" FontSize="10" FontWeight="Bold" Foreground="#FFC200"/>
                                        <TextBlock Grid.Column="6" Text="P.U" FontSize="10" FontWeight="Bold" Foreground="#FFC200"/>
                                        <TextBlock Grid.Column="7" Text="MONTANT" FontSize="10" FontWeight="Bold" Foreground="#FFC200"/>
                                    </Grid>
                                </Border>

                                <!-- Ligne 1 : Pompe 1 - Super -->
                                <Border Background="#0E2848" Padding="10,6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="CbIlot1" Margin="0,0,5,0" Height="32"
                                                  Background="#0F3460" Foreground="#FFC200"
                                                  SelectionChanged="Ilot_Changed">
                                            <ComboBoxItem Content="Îlot 1" IsSelected="True"/>
                                            <ComboBoxItem Content="Îlot 2"/>
                                            <ComboBoxItem Content="Îlot 3"/>
                                        </ComboBox>
                                        <ComboBox Grid.Column="1" x:Name="CbPompe1" Margin="0,0,5,0" Height="32"
                                                  Background="#0F3460" Foreground="#8BAFD4">
                                            <ComboBoxItem Content="P1" IsSelected="True"/>
                                            <ComboBoxItem Content="P2"/>
                                            <ComboBoxItem Content="P3"/>
                                        </ComboBox>
                                        <ComboBox Grid.Column="2" x:Name="CbCarb1" Margin="0,0,5,0" Height="32"
                                                  Background="#0F3460" Foreground="#FFC200"
                                                  SelectionChanged="Carburant_Changed">
                                            <ComboBoxItem Content="Super" IsSelected="True"/>
                                            <ComboBoxItem Content="Gasoil"/>
                                        </ComboBox>
                                        <TextBox Grid.Column="3" Margin="0,0,5,0" Height="32"
                                                 Background="#1A2D50" Foreground="#8BAFD4"
                                                 BorderBrush="#2A4060" BorderThickness="0,0,0,1"
                                                 Padding="6,4" IsReadOnly="True" Text="0.00"/>
                                        <TextBox Grid.Column="4" x:Name="TxtArr1" Margin="0,0,5,0" Height="32"
                                                 Background="#0F3460" Foreground="White"
                                                 BorderBrush="#FFC200" BorderThickness="0,0,0,2"
                                                 Padding="6,4" TextChanged="IndexArrivee_Changed"/>
                                        <TextBox Grid.Column="5" x:Name="TxtQte1" Margin="0,0,5,0" Height="32"
                                                 Background="#1A2D50" Foreground="#00C896"
                                                 BorderThickness="0" Padding="6,4" IsReadOnly="True"/>
                                        <TextBox Grid.Column="6" x:Name="TxtPu1" Margin="0,0,5,0" Height="32"
                                                 Background="#1A2D50" Foreground="#FFC200"
                                                 BorderThickness="0" Padding="6,4"
                                                 IsReadOnly="True" Text="920"/>
                                        <TextBox Grid.Column="7" x:Name="TxtTotal1" Height="32"
                                                 Background="#1A2D50" Foreground="White"
                                                 BorderThickness="0" Padding="6,4" IsReadOnly="True"/>
                                    </Grid>
                                </Border>

                                <!-- Ligne 2 : Pompe 1 - Gasoil -->
                                <Border Background="#0E2848" Padding="10,6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="CbIlot2" Margin="0,0,5,0" Height="32"
                                                  Background="#0F3460" Foreground="#FFC200"
                                                  SelectionChanged="Ilot_Changed">
                                            <ComboBoxItem Content="Îlot 1" IsSelected="True"/>
                                            <ComboBoxItem Content="Îlot 2"/>
                                            <ComboBoxItem Content="Îlot 3"/>
                                        </ComboBox>
                                        <ComboBox Grid.Column="1" x:Name="CbPompe2" Margin="0,0,5,0" Height="32"
                                                  Background="#0F3460" Foreground="#8BAFD4">
                                            <ComboBoxItem Content="P1" IsSelected="True"/>
                                            <ComboBoxItem Content="P2"/>
                                            <ComboBoxItem Content="P3"/>
                                        </ComboBox>
                                        <ComboBox Grid.Column="2" x:Name="CbCarb2" Margin="0,0,5,0" Height="32"
                                                  Background="#0F3460" Foreground="#FFC200"
                                                  SelectionChanged="Carburant_Changed">
                                            <ComboBoxItem Content="Super"/>
                                            <ComboBoxItem Content="Gasoil" IsSelected="True"/>
                                        </ComboBox>
                                        <TextBox Grid.Column="3" Margin="0,0,5,0" Height="32"
                                                 Background="#1A2D50" Foreground="#8BAFD4"
                                                 BorderBrush="#2A4060" BorderThickness="0,0,0,1"
                                                 Padding="6,4" IsReadOnly="True" Text="0.00"/>
                                        <TextBox Grid.Column="4" x:Name="TxtArr2" Margin="0,0,5,0" Height="32"
                                                 Background="#0F3460" Foreground="White"
                                                 BorderBrush="#FFC200" BorderThickness="0,0,0,2"
                                                 Padding="6,4" TextChanged="IndexArrivee_Changed"/>
                                        <TextBox Grid.Column="5" x:Name="TxtQte2" Margin="0,0,5,0" Height="32"
                                                 Background="#1A2D50" Foreground="#00C896"
                                                 BorderThickness="0" Padding="6,4" IsReadOnly="True"/>
                                        <TextBox Grid.Column="6" x:Name="TxtPu2" Margin="0,0,5,0" Height="32"
                                                 Background="#1A2D50" Foreground="#FFC200"
                                                 BorderThickness="0" Padding="6,4"
                                                 IsReadOnly="True" Text="680"/>
                                        <TextBox Grid.Column="7" x:Name="TxtTotal2" Height="32"
                                                 Background="#1A2D50" Foreground="White"
                                                 BorderThickness="0" Padding="6,4" IsReadOnly="True"/>
                                    </Grid>
                                </Border>

                                <!-- Ligne 3 : Pompe 2 - Super -->
                                <Border Background="#0E2848" Padding="10,6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="CbIlot3" Margin="0,0,5,0" Height="32"
                                                  Background="#0F3460" Foreground="#FFC200"
                                                  SelectionChanged="Ilot_Changed">
                                            <ComboBoxItem Content="Îlot 1"/>
                                            <ComboBoxItem Content="Îlot 2" IsSelected="True"/>
                                            <ComboBoxItem Content="Îlot 3"/>
                                        </ComboBox>
                                        <ComboBox Grid.Column="1" x:Name="CbPompe3" Margin="0,0,5,0" Height="32"
                                                  Background="#0F3460" Foreground="#8BAFD4">
                                            <ComboBoxItem Content="P1"/>
                                            <ComboBoxItem Content="P2" IsSelected="True"/>
                                            <ComboBoxItem Content="P3"/>
                                        </ComboBox>
                                        <ComboBox Grid.Column="2" x:Name="CbCarb3" Margin="0,0,5,0" Height="32"
                                                  Background="#0F3460" Foreground="#FFC200"
                                                  SelectionChanged="Carburant_Changed">
                                            <ComboBoxItem Content="Super" IsSelected="True"/>
                                            <ComboBoxItem Content="Gasoil"/>
                                        </ComboBox>
                                        <TextBox Grid.Column="3" Margin="0,0,5,0" Height="32"
                                                 Background="#1A2D50" Foreground="#8BAFD4"
                                                 BorderBrush="#2A4060" BorderThickness="0,0,0,1"
                                                 Padding="6,4" IsReadOnly="True" Text="0.00"/>
                                        <TextBox Grid.Column="4" x:Name="TxtArr3" Margin="0,0,5,0" Height="32"
                                                 Background="#0F3460" Foreground="White"
                                                 BorderBrush="#FFC200" BorderThickness="0,0,0,2"
                                                 Padding="6,4" TextChanged="IndexArrivee_Changed"/>
                                        <TextBox Grid.Column="5" x:Name="TxtQte3" Margin="0,0,5,0" Height="32"
                                                 Background="#1A2D50" Foreground="#00C896"
                                                 BorderThickness="0" Padding="6,4" IsReadOnly="True"/>
                                        <TextBox Grid.Column="6" x:Name="TxtPu3" Margin="0,0,5,0" Height="32"
                                                 Background="#1A2D50" Foreground="#FFC200"
                                                 BorderThickness="0" Padding="6,4"
                                                 IsReadOnly="True" Text="920"/>
                                        <TextBox Grid.Column="7" x:Name="TxtTotal3" Height="32"
                                                 Background="#1A2D50" Foreground="White"
                                                 BorderThickness="0" Padding="6,4" IsReadOnly="True"/>
                                    </Grid>
                                </Border>

                                <!-- Ligne 4 : Pompe 2 - Gasoil -->
                                <Border Background="#0E2848" Padding="10,6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="CbIlot4" Margin="0,0,5,0" Height="32"
                                                  Background="#0F3460" Foreground="#FFC200"
                                                  SelectionChanged="Ilot_Changed">
                                            <ComboBoxItem Content="Îlot 1"/>
                                            <ComboBoxItem Content="Îlot 2" IsSelected="True"/>
                                            <ComboBoxItem Content="Îlot 3"/>
                                        </ComboBox>
                                        <ComboBox Grid.Column="1" x:Name="CbPompe4" Margin="0,0,5,0" Height="32"
                                                  Background="#0F3460" Foreground="#8BAFD4">
                                            <ComboBoxItem Content="P1"/>
                                            <ComboBoxItem Content="P2" IsSelected="True"/>
                                            <ComboBoxItem Content="P3"/>
                                        </ComboBox>
                                        <ComboBox Grid.Column="2" x:Name="CbCarb4" Margin="0,0,5,0" Height="32"
                                                  Background="#0F3460" Foreground="#FFC200"
                                                  SelectionChanged="Carburant_Changed">
                                            <ComboBoxItem Content="Super"/>
                                            <ComboBoxItem Content="Gasoil" IsSelected="True"/>
                                        </ComboBox>
                                        <TextBox Grid.Column="3" Margin="0,0,5,0" Height="32"
                                                 Background="#1A2D50" Foreground="#8BAFD4"
                                                 BorderBrush="#2A4060" BorderThickness="0,0,0,1"
                                                 Padding="6,4" IsReadOnly="True" Text="0.00"/>
                                        <TextBox Grid.Column="4" x:Name="TxtArr4" Margin="0,0,5,0" Height="32"
                                                 Background="#0F3460" Foreground="White"
                                                 BorderBrush="#FFC200" BorderThickness="0,0,0,2"
                                                 Padding="6,4" TextChanged="IndexArrivee_Changed"/>
                                        <TextBox Grid.Column="5" x:Name="TxtQte4" Margin="0,0,5,0" Height="32"
                                                 Background="#1A2D50" Foreground="#00C896"
                                                 BorderThickness="0" Padding="6,4" IsReadOnly="True"/>
                                        <TextBox Grid.Column="6" x:Name="TxtPu4" Margin="0,0,5,0" Height="32"
                                                 Background="#1A2D50" Foreground="#FFC200"
                                                 BorderThickness="0" Padding="6,4"
                                                 IsReadOnly="True" Text="680"/>
